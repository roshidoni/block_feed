{
  "manifest_version": 2,
  "name": "Feed Blocker",
  "short_name": "Feed Blocker",
  "version": "1.9",
  "description": "Blocks YouTube overnight, hides its feed and Shorts during the day, blocks LinkedIn, and filters Telegram Web chats on weekdays.",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "64": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://*.youtube.com/*",
    "*://*.linkedin.com/*"
  ],
  "background": {
    "scripts": ["youtube-schedule.js", "background.js"]
  },
  "web_accessible_resources": ["blocked.html"],
  "content_scripts": [
    {
      "matches": ["*://*.telegram.org/*"],
      "js": ["telegram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube-schedule.js", "youtube.js"],
      "css": ["youtube.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{ed34459f-78c4-409e-8b6f-bfcc772de6b9}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
